# HTTPS Redirect Plugin
# Uses only server-injected globals (NO imports)

# -----------------------------
# Paths
# -----------------------------
CONFIG_DIR = os.path.join(os.path.dirname(__file__), "..", "..", "config")
CONFIG_DIR = os.path.abspath(CONFIG_DIR)
HTTPS_CONFIG_FILE = os.path.join(CONFIG_DIR, "https.json")

# -----------------------------
# Default HTTPS config
# -----------------------------
default_https_config = {
    "enabled": False,
    "force_redirect": True,
    "domain": "",        # example.com
    "public_ip": "",     # 1.2.3.4 (used if domain is empty)
    "https_port": 443,
    "add_hsts": False
}

# -----------------------------
# Ensure config directory exists
# -----------------------------
os.makedirs(CONFIG_DIR, exist_ok=True)

# -----------------------------
# Load / create https.json
# -----------------------------
if not os.path.exists(HTTPS_CONFIG_FILE):
    with open(HTTPS_CONFIG_FILE, "w") as f:
        f.write(json.dumps(default_https_config, indent=4))

try:
    with open(HTTPS_CONFIG_FILE, "r") as f:
        https_config = json.loads(f.read())
except:
    https_config = default_https_config

# Merge defaults (future-proof)
for k, v in default_https_config.items():
    if k not in https_config:
        https_config[k] = v

# -----------------------------
# Helper: build HTTPS host
# -----------------------------
def get_https_host(request):
    if https_config.get("domain"):
        return https_config["domain"]
    if https_config.get("public_ip"):
        return https_config["public_ip"]
    return request["headers"].get("host", "")

# -----------------------------
# Redirect logic
# -----------------------------
def https_redirect_hook(request, response):
    if not https_config.get("enabled"):
        return

    if not https_config.get("force_redirect"):
        return

    # Detect HTTP
    proto = request["headers"].get("x-forwarded-proto", "http")
    if proto.lower() == "https":
        return

    host = get_https_host(request)
    if not host:
        return

    port = https_config.get("https_port", 443)
    port_part = "" if port == 443 else f":{port}"

    location = f"https://{host}{port_part}{request['path']}"

    response["status"] = 301
    response["headers"] = {
        "Location": location,
        "Content-Length": "0"
    }
    response["body"] = b""

# -----------------------------
# Security headers
# -----------------------------
def security_headers_hook(request, response):
    if not https_config.get("enabled"):
        return

    headers = response.setdefault("headers", {})

    headers.setdefault("X-Content-Type-Options", "nosniff")
    headers.setdefault("X-Frame-Options", "DENY")
    headers.setdefault("Referrer-Policy", "no-referrer")

    if https_config.get("add_hsts"):
        headers.setdefault(
            "Strict-Transport-Security",
            "max-age=31536000; includeSubDomains"
        )

# -----------------------------
# Register hooks
# -----------------------------
plugin_hooks["after_request"].append(https_redirect_hook)
plugin_hooks["after_request"].append(security_headers_hook)

print("[HTTPS PLUGIN] Loaded (config: config/https.json)")
